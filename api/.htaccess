# Protect database files that might end up in api/ directory
<FilesMatch "\.(db|db-wal|db-shm|sqlite|sqlite3)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect seed.php from unauthorized access after initial use
# Uncomment the lines below after seeding is complete:
